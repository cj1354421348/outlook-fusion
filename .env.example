# ===== Outlook Fusion 环境变量模板 =====
# 复制为 .env 并填写（.env 已被 gitignore，不会入库）
# --- 数据库（PG 主源）---
DATABASE_URL=postgresql+asyncpg://outlook:outlook@localhost:5432/outlook_fusion

# --- 安全（必须自行生成）---
# SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# TOKEN_ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# 轮换期旧 key（可选，双读）
TOKEN_ENCRYPTION_KEY_OLD=
APP_USERNAME=admin
APP_PASSWORD=admin
LOCK_THRESHOLD=5
LOCK_DURATION_SECONDS=3600

# --- OAuth / Microsoft ---
# Public Client 用 /consumers；组织账户参考配置
AUTHORITY=https://login.microsoftonline.com/consumers
# 新账户授权默认 client_id
DEFAULT_CLIENT_ID=
# 开发期 localhost 隧道 URL；部署期切公网域名
REDIRECT_BASE_URL=http://localhost:8000
OAUTH_SCOPE=offline_access https://outlook.office.com/IMAP.AccessAsUser.All Mail.Read
GRAPH_SCOPE=https://graph.microsoft.com/.default offline_access
IMAP_SCOPE=https://outlook.office.com/IMAP.AccessAsUser.All offline_access

# --- IMAP ---
IMAP_SERVER_OFFICE365=outlook.office365.com
IMAP_SERVER_LIVE=outlook.live.com
IMAP_PORT=993
MAX_CONNECTIONS=5

# --- 调度（保活默认每天，上限7天）---
REFRESH_INTERVAL_HOURS=24
TOKEN_HEALTH_ENABLED=true

# --- 平台保活（Render 等免费实例防休眠）---
# 留空则自动使用 RENDER_EXTERNAL_URL（Render 自动注入公网地址）
KEEPALIVE_URL=
KEEPALIVE_INTERVAL_MINUTES=10

# --- 通知（webhook，沿用 Notify Hub 协议）---
NOTIFY_API_URL=
NOTIFY_KEY=

# --- CORS（逗号分隔白名单；空=仅同源）---
CORS_ORIGINS=